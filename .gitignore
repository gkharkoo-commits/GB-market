# ==============================================================================
# GB MARKET — Master .gitignore for Safe Public GitHub Repository
# ==============================================================================

# Python Bytecode & Runtime
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
secrets/

# Databases & Backups (Never commit real or test database files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.sql
*.sha256
backups/*
!backups/.gitkeep

# Uploads & Media (Preserve structure with .gitkeep, ignore runtime files)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/documents/.gitkeep
!backend/uploads/shops/.gitkeep
!backend/uploads/products/.gitkeep
!backend/uploads/profiles/.gitkeep
!backend/uploads/general/.gitkeep

# Temporary & Debug Screenshots (Do not bloat repo with dev snapshots)
website/assets/debug-*.png
website/assets/snap-*.png
website/assets/chrome-snap.png

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/

# Logs & Temporary Files
*.log
*.tmp
*.bak
*.swp
*.swo

# Operating System & IDEs
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
